generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザーモデル
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  cards        Card[]   // ユーザーが作成したカード（1対多）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 言葉カードモデル
model Card {
  id             String   @id @default(cuid())
  quote          String   // 心に残った言葉（100文字制限はZod/フロントで制御）
  bookTitle      String   // 本のタイトル
  authorName     String?  // 著者名（不詳などのため任意）
  isbn           String?　// ISBNコード（将来のEC連携用）
  externalBookId String? // Google Books ID等（API連携用
  isPublic       Boolean  @default(true) // 公開/非公開フラグ

  // 投稿者のユーザーID（外部キー）
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}